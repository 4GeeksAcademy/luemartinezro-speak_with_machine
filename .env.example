# ──────────────────────────────────────────────
# Groq Chat Console — Variables de Entorno
# ──────────────────────────────────────────────
# Copia este archivo a .env y completa los valores.
#
#   cp .env.example .env
#
# El archivo .env contiene credenciales reales y NO debe
# subirse al repositorio (ya está incluido en .gitignore).

# ─── GROQ API KEY ──────────────────────────────
# Necesitas una cuenta en Groq (https://console.groq.com) para obtener
# una API Key. Una vez registrado:
#   1. Ve a https://console.groq.com/keys
#   2. Haz clic en "Create API Key"
#   3. Copia la llave generada y pégala aquí
#
# Esta variable es OBLIGATORIA. Sin ella la aplicación mostrará
# un error 500 al intentar enviar mensajes.
GROQ_API_KEY=tu_api_key_aqui